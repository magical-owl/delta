{
  "name": "Delta Dashboard - Compliance & Audit Archival Pipeline (Candidate 05)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "delta-compliance-archival",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c1a1b1c1-1111-4aaa-bbbb-000000000001",
      "name": "Audit Archival Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "delta-compliance-archival"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "archiveBatchId",
              "value": "=ARCH-{{ Math.floor(100000 + Math.random() * 900000) }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "retentionPeriodDays",
              "value": "={{ $json.body.retentionDays || 365 }}",
              "type": "number"
            },
            {
              "id": "3",
              "name": "sha256Digest",
              "value": "={{ $json.body.digest || 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "recordCount",
              "value": "={{ $json.body.recordCount || 250 }}",
              "type": "number"
            },
            {
              "id": "5",
              "name": "storageTier",
              "value": "AWS S3 Glacier WORM (Write Once Read Many)",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c1a1b1c1-2222-4aaa-bbbb-000000000002",
      "name": "Batch Metadata Digest & Tagging",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"status\": \"archival_job_accepted\",\n  \"archiveBatchId\": \"{{ $json.archiveBatchId }}\",\n  \"recordsIndexed\": {{ $json.recordCount }},\n  \"retentionDays\": {{ $json.retentionPeriodDays }},\n  \"cryptographicDigest\": \"{{ $json.sha256Digest }}\",\n  \"storageTier\": \"{{ $json.storageTier }}\",\n  \"complianceCertificateUrl\": \"https://s3.us-east-1.amazonaws.com/delta-compliance/certs/{{ $json.archiveBatchId }}.pdf\",\n  \"timestamp\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "c1a1b1c1-3333-4aaa-bbbb-000000000003",
      "name": "Return Archival Confirmation",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [760, 300]
    }
  ],
  "connections": {
    "Audit Archival Webhook": {
      "main": [
        [
          {
            "node": "Batch Metadata Digest & Tagging",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Batch Metadata Digest & Tagging": {
      "main": [
        [
          {
            "node": "Return Archival Confirmation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
