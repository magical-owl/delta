                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "workspace.health_check",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
